{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://ubcdiscovery.com",
          "https://ubc-discovery-web.ubcdiscovery.workers.dev"
        ],
        "methods": ["PUT"],
        "headers": ["Content-Type"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
