BETA_HOSTNAME=beta.invalid
# Non-zero fake digests allow offline structure validation but cannot be deployed.
# A reviewed release.env must replace them with registry-resolved digests.
API_IMAGE=ghcr.io/example/ubc-discovery-backend@sha256:1111111111111111111111111111111111111111111111111111111111111111
CADDY_IMAGE=caddy:2.10.0-alpine@sha256:2222222222222222222222222222222222222222222222222222222222222222
POSTGRES_IMAGE=postgres:18.4-bookworm@sha256:3333333333333333333333333333333333333333333333333333333333333333
API_ENV_FILE=/opt/ubc-discovery-beta/runtime/api.env
POSTGRES_ENV_FILE=/opt/ubc-discovery-beta/runtime/postgres.env
