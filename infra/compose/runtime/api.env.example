# Copy to api.env on the beta host and replace every REPLACE value.
DATABASE_URL=postgresql+asyncpg://ubc_discovery:REPLACE_PASSWORD@postgres:5432/ubc_discovery_beta
# Safe only because PostgreSQL is confined to Compose's internal data network.
DATABASE_SSL=disable
FIREBASE_CREDENTIALS_JSON=REPLACE_WITH_BETA_ONLY_JSON
FIREBASE_PROJECT_ID=REPLACE_WITH_BETA_PROJECT_ID
ADMIN_API_KEY=
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=
EMAIL_SENDER_EMAIL=
CORS_ALLOWED_ORIGINS=["https://beta.invalid"]
CORS_ALLOWED_ORIGIN_REGEX=
