{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ubc-discovery-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "DATABASE_SSL": "true",
    "AWS_REGION": "us-west-2",
    "STORAGE_PROVIDER": "r2",
    "R2_ACCOUNT_ID": "5637cded1864726ba930947d2f6138af",
    "R2_BUCKET_NAME": "ubc-discovery-api-staging-media",
    "CORS_ALLOWED_ORIGINS": "[\"http://localhost:5173\"]",
    "OTP_EXPIRY_MINUTES": "10",
    "OTP_MAX_ATTEMPTS": "5",
    "OTP_RATE_LIMIT_PER_15MIN": "3",
    "EXTRACTION_DELIVERY_TIMEOUT_SECONDS": "90000",
  },
  "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "ubc-discovery-api-staging-media" }],
  "env": {
    "production": {
      "name": "ubc-discovery-api",
      "account_id": "5637cded1864726ba930947d2f6138af",
      "workers_dev": true,
      "vars": {
        "DATABASE_SSL": "true",
        "AWS_REGION": "us-west-2",
        "STORAGE_PROVIDER": "r2",
        "R2_ACCOUNT_ID": "5637cded1864726ba930947d2f6138af",
        "R2_BUCKET_NAME": "ubc-discovery-media",
        "API_PUBLIC_BASE_URL": "https://ubc-discovery-api.ubcdiscovery.workers.dev",
        "CORS_ALLOWED_ORIGINS": "[\"https://ubcdiscovery.com\",\"https://ubc-discovery-web.ubcdiscovery.workers.dev\"]",
        "OTP_EXPIRY_MINUTES": "10",
        "OTP_MAX_ATTEMPTS": "5",
        "OTP_RATE_LIMIT_PER_15MIN": "3",
        "EXTRACTION_DELIVERY_TIMEOUT_SECONDS": "90000",
        "EXTRACTION_QUEUE_PRODUCER_URL": "https://ubc-discovery-extraction.ubcdiscovery.workers.dev/enqueue",
      },
      "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "ubc-discovery-media" }],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "FIREBASE_PROJECT_ID",
          "FIREBASE_CREDENTIALS_JSON",
          "AWS_ACCESS_KEY_ID",
          "AWS_SECRET_ACCESS_KEY",
          "EMAIL_SENDER_EMAIL",
          "R2_ACCESS_KEY_ID",
          "R2_SECRET_ACCESS_KEY",
          "UPLOAD_SIGNING_SECRET",
          "EXTRACTION_QUEUE_PRODUCER_SECRET",
        ],
      },
    },
  },
}
