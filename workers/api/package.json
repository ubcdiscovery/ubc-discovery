{
  "name": "ubc-discovery-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false",
    "typecheck": "pnpm run types && tsc --noEmit",
    "lint": "pnpm --workspace-root exec vp lint workers/api && pnpm --workspace-root exec vp fmt --check workers/api",
    "test": "vp test run",
    "test:runtime": "node scripts/runtime-check.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build": "wrangler deploy --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.16",
    "@sinclair/typebox": "0.34.52",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "elysia": "1.4.30",
    "jose": "6.2.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "24.x"
  }
}
