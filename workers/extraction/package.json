{
  "name": "ubc-discovery-extraction",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "pnpm run types && tsc --noEmit",
    "lint": "pnpm --workspace-root exec vp lint workers/extraction",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime=false --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
