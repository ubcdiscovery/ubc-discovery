{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Hosting validation defaults to a separate staging Worker. Production routes
  // are intentionally absent until the coordinated API/storage cutover.
  "name": "ubc-discovery-web-staging",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "directory": "./build/client"
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
