{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deadcode": "knip",
    "dev": "react-router dev",
    "lint": "pnpm run types && pnpm --workspace-root exec vp lint web && pnpm --workspace-root exec vp fmt --check web",
    "start": "vp preview --host 127.0.0.1 --port 4173",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnvironment",
    "typecheck": "pnpm run types && react-router typegen && tsc",
    "deploy:staging": "VITE_AUTH_TEST_MODE=false pnpm run build && wrangler deploy",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-router": "8.2.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "8.2.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "jiti": "^2.7.0",
    "knip": "^6.29.0",
    "tailwindcss": "^4.2.2",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": "24.x"
  },
  "knip": {
    "ignoreDependencies": [
      "eslint-plugin-better-tailwindcss"
    ]
  }
}
