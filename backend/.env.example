# Database
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@RDS_ENDPOINT:5432/DATABASE
# Set false for the local PostgreSQL Compose service.
DATABASE_SSL=true

# AWS (S3, Bedrock Titan, SES)
AWS_REGION=us-west-2
S3_BUCKET_NAME=
S3_PUBLIC_BASE_URL=https://YOUR_BUCKET_NAME.s3.us-west-2.amazonaws.com
PROFILE_PHOTO_MAX_BYTES=524288
EVENT_IMAGE_MAX_BYTES=3145728
CANDIDATE_IMAGE_MAX_BYTES=5242880

# Candidate extraction (OpenAI Chat Completions)
OPENAI_API_KEY=
EXTRACTION_ENABLED=false
EXTRACTION_MODEL=gpt-5.6-luna
EXTRACTION_REASONING_EFFORT=none
EXTRACTION_IMAGE_DETAIL=high
EXTRACTION_BATCH_SIZE=10
EXTRACTION_QUIET_SECONDS=120
EXTRACTION_IMAGE_WAIT_SECONDS=300
EXTRACTION_IMAGE_SETTLE_SECONDS=30
EXTRACTION_IMAGE_RETRY_SECONDS=15
EXTRACTION_POLL_SECONDS=5
EXTRACTION_IDLE_SECONDS=20
EXTRACTION_CLAIM_TIMEOUT_SECONDS=300
EXTRACTION_MAX_ATTEMPTS=5

# Firebase Auth
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Sender Email
EMAIL_SENDER_EMAIL=noreply@ubcdiscovery.com

# CORS — add your production web URL here (e.g. https://app.yourdomain.com)
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Optional: allow Vercel preview deploys for this Vercel scope without allowing all vercel.app.
# Example: https://ubc-discovery-git-branch-name-wtarits-projects.vercel.app
CORS_ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+-wtarits-projects\.vercel\.app$
